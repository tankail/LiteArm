<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="litearm_left_arm_hardware_ros2_control" params="name config_file control_mode">

        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>litearm_hardware/LiteArmHardwareInterface</plugin>
                <param name="config_file">${config_file}</param>
                <param name="control_mode">${control_mode}</param>
                <param name="gripper_rad_to_m">0.025</param>
            </hardware>

            <!-- Joint 1 - Left Shoulder Roll -->
            <joint name="l_joint1_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="max_torque">21.0</param>
                <param name="max_velocity">1.0</param>
                <param name="kp">4.0</param>
                <param name="kd">0.5</param>
            </joint>

            <!-- Joint 2 - Left Shoulder Pitch -->
            <joint name="l_joint2_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="max_torque">36.0</param>
                <param name="max_velocity">1.0</param>
                <param name="kp">10.0</param>
                <param name="kd">0.8</param>
            </joint>

            <!-- Joint 3 - Left Shoulder Pitch -->
            <joint name="l_joint3_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="max_torque">36.0</param>
                <param name="max_velocity">1.0</param>
                <param name="kp">10.0</param>
                <param name="kd">0.8</param>
            </joint>

            <!-- Joint 4 - Left Elbow Roll -->
            <joint name="l_joint4_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="max_torque">21.0</param>
                <param name="max_velocity">1.0</param>
                <param name="kp">2.0</param>
                <param name="kd">0.2</param>
            </joint>

            <!-- Joint 5 - Left Wrist Pitch -->
            <joint name="l_joint5_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="max_torque">10.0</param>
                <param name="max_velocity">1.0</param>
                <param name="kp">2.0</param>
                <param name="kd">0.2</param>
            </joint>

            <!-- Joint 6 - Left Wrist Roll -->
            <joint name="l_joint6_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="max_torque">10.0</param>
                <param name="max_velocity">1.0</param>
                <param name="kp">1.0</param>
                <param name="kd">0.1</param>
            </joint>

            <!-- Joint 7 - Left Wrist Pitch -->
            <joint name="l_joint7_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="max_torque">10.0</param>
                <param name="max_velocity">1.0</param>
                <param name="kp">2.0</param>
                <param name="kd">0.2</param>
            </joint>

            <!-- Left Gripper Right Finger (controlled by single motor) -->
            <joint name="l_r_finger_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="max_torque">0.5</param>
                <param name="max_velocity">0.5</param>
                <param name="kp">1.0</param>
                <param name="kd">0.1</param>
            </joint>

            <!-- Left Gripper Left Finger (mimics right finger, not directly controlled) -->
            <joint name="l_l_finger_joint">
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
